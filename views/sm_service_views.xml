<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vistas de Lista De Serviços -->
    <record id="view_sm_service_list" model="ir.ui.view">
        <field name="name">sm.service.list</field>
        <field name="model">sm.service</field>
        <field name="arch" type="xml">
            <list string="Serviços">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="service_type"/>
                <field name="price" sum="Preço Total"/>
                <field name="execution_time"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- 2. Ação de janela para Serviço -->
    <record id="action_sm_service" model="ir.actions.act_window">
        <field name="name">Catálogo de Serviço</field>
        <field name="res_model">sm.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum serviço cadastrado ainda
            </p>
            <p>
                Clique ainda no botão Novo para cadrastrar o primeiro serviço no catálogo!
            </p>
        </field>
    </record>


    <!-- 3. Ação de Janela para Categorias -->
    <record id="action_sm_service_category" model="ir.actions.act_window">
        <field name="name">Categorias de Serviço</field>
        <field name="res_model">sm.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>