<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="sm_tag_view_form" model="ir.ui.view">
        <field name="name">sm.tag.view.form</field>
        <field name="model">sm.tag</field>
        <field name="arch" type="xml">
            <form string="Sm_tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- Add your fields here -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="sm_tag_view_list" model="ir.ui.view">
        <field name="name">sm.tag.view.list</field>
        <field name="model">sm.tag</field>
        <field name="arch" type="xml">
            <list string="Sm_tag">
                <field name="name"/>
                <!-- Add your fields here -->
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="sm_tag_action" model="ir.actions.act_window">
        <field name="name">Sm tag</field>
        <field name="res_model">sm.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sm tag!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="sm_tag_menu"
              name="Sm tag"
              action="sm_tag_action"
              sequence="10"/>
</odoo>