<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="sm_tag_view_form" model="ir.ui.view">
        <field name="name">sm.tag.view.form</field>
        <field name="model">sm.tag</field>
        <field name="arch" type="xml">
            <form string="Sm_tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle_confirm"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="sm_tag_view_list" model="ir.ui.view">
        <field name="name">sm.tag.view.list</field>
        <field name="model">sm.tag</field>
        <field name="arch" type="xml">
            <list string="Etiquetas">
                <field name="name"/>
                <field name="active" widget="boolean_toggle_confirm"/>
                <field name="color"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_sm_tag" model="ir.actions.act_window">
        <field name="name">Classificação de Etiqueta</field>
        <field name="res_model">sm.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma Etiqueta criada ainda!
            </p>
            <p>
                Crie a tua primeira Etiqueta!
            </p>
        </field>
    </record>

</odoo>