<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Vista de Pesquisa (Search View) -->
    <record id="view_sm_work_order_search" model="ir.ui.view">
        <field name="name">sm.work.order.search</field>
        <field name="model">sm.work.order</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Ordens de Serviço">
                <field name="name" string="OS, Cliente ou Técnico"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('technician_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="quotation_id"/>
                <field name="request_id"/>
                <separator/>
                <filter string="Pendentes" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Em Execução" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Concluídas" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Canceladas" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Com Técnico Atribuído" name="filter_has_technician" domain="[('technician_id', '!=', False)]"/>
                <filter string="Sem Técnico Atribuído" name="filter_no_technician" domain="[('technician_id', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Técnico" name="group_by_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Data de Início" name="group_by_date_start" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. Vista de Lista (List View) -->
    <record id="view_sm_work_order_list" model="ir.ui.view">
        <field name="name">sm.work.order.list</field>
        <field name="model">sm.work.order</field>
        <field name="arch" type="xml">
            <list string="Ordens de Serviço"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 3. Vista de Formulário (Form View) -->
    <record id="view_sm_work_order_form" model="ir.ui.view">
        <field name="name">sm.work.order.form</field>
        <field name="model">sm.work.order</field>
        <field name="arch" type="xml">
            <form string="Ordem de Serviço">
                <header>
                    <button name="action_start" string="Iniciar Execução" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Concluir OS" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informações Gerais">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="technician_id" readonly="state not in ('draft', 'in_progress')"/>
                            <field name="quotation_id" readonly="state != 'draft'"/>
                            <field name="request_id"/>
                        </group>
                        <group string="Datas e Prazos">
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrição do Trabalho" name="description">
                            <field name="description" placeholder="Descreva os serviços que o técnico deverá realizar..." readonly="state != 'draft'"/>
                        </page>
                        <page string="Notas Técnicas" name="technical_notes">
                            <field name="technical_notes" placeholder="Relatório pós-atendimento, peças utilizadas ou observações do técnico..." readonly="state == 'done'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 4. Ação de Janela para Ordem de Serviço -->
    <record id="action_sm_work_order" model="ir.actions.act_window">
        <field name="name">Ordens de Serviço</field>
        <field name="res_model">sm.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sm_work_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma Ordem de Serviço registada ainda.
            </p>
            <p>
                As Ordens de Serviço são geradas automaticamente após a aprovação de um orçamento.
            </p>
        </field>
    </record>

</odoo>
