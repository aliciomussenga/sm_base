<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- 1. Vista de Pesquisa (Search View) -->
    <record id="view_sm_quotation_search" model="ir.ui.view">
        <field name="name">sm.quotation.search</field>
        <field name="model">sm.quotation</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Orçamentos">
                <!-- 1. Campos onde a busca por texto vai atuar -->
                <field name="name" string="Número ou Cliente"
                       filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="tag_ids"/>

                <!-- 2. Filtros Rápidos (Botões de acionamento único) -->
                <filter string="Rascunhos" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aprovados" name="filter_approved" domain="[('state', '=', 'approved')]"/>

                <separator/>

                <!-- 3. Opções de Agrupamento (Group By) -->
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. Vista de Lista de Orçamento -->
    <record id="view_sm_quotation_list" model="ir.ui.view">
        <field name="name">sm.quotation.list</field>
        <field name="model">sm.quotation</field>
        <field name="arch" type="xml">
            <list string="Orçamento de Serviço">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_quotation"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="amount_total" sum="Total Geral"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <!-- 3. Vista de Formulário de Orçamento -->
    <record id="view_sm_quotation_form" model="ir.ui.view">
        <field name="name">sm.quotation.form</field>
        <field name="model">sm.quotation</field>
        <field name="arch" type="xml">
            <form string="Orçamento de Serviço">
                <!-- Cabeçalho com Statusbar -->
                <header>
                    <button name="action_send_quotation"
                            string="Enviar por Email"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Aprovar"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'sent')"/>

                    <button name="action_refuse"
                            string="Recusar"
                            type="object"
                            invisible="state not in ('draft', 'sent')"/>

                    <button name="action_draft"
                            string="Restaurar p/ Rascunho"
                            type="object"
                            invisible="state not in ('refused', 'approve')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>

                <sheet>
                    <!-- Título em Destaque -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Número do Orçamento..."/>
                        </h1>
                    </div>

                    <!-- Organização em Duas Colunas -->
                    <group>
                        <group string="Informação do Cliente">
                            <field name="partner_id"/>
                            <field name="request_id"/>
                        </group>
                        <group string="Detalhes da Proposta">
                            <field name="date_quotation"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>

                    <!-- Abas com Tabela One2many Inline -->
                    <notebook>
                        <page string="Serviços Orçamentados">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </list>
                            </field>

                            <!-- Sumário Financeiro alinhado à direita -->
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. Vista Kanban -->
    <record id="view_sm_quotation_kanban" model="ir.ui.view">
        <field name="name">sm.quotation.kanban</field>
        <field name="model">sm.quotation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="partner_id"/>
                                </div>
                                <div class="text_muted">
                                    <span>Total: </span>
                                    <strong><field name="amount_total"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 5. Ação de Janela para Orçamentos -->
    <record id="action_sm_quotation" model="ir.actions.act_window">
        <field name="name">Orçamentos de Serviços</field>
        <field name="res_model">sm.quotation</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- 6. Menu Item de Orçamentos -->
    <menuitem id="menu_sm_quotation_action"
              name="Orçamentos"
              parent="menu_sm_root"
              action="action_sm_quotation"
              sequence="20"/>

</odoo>