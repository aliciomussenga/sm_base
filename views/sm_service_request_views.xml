<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Form View -->
    <record id="view_sm_service_request_form" model="ir.ui.view">
        <field name="name">sm.service.request.form</field>
        <field name="model">sm.service.request</field>
        <field name="arch" type="xml">
            <form string="Solicitação de Serviço">
                <header>
                    <button name="action_in_analysis"
                            string="Submeter para Análise"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state in ('quoted', 'cancel')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_analysis,quoted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informações Principais">
                            <field name="title" placeholder="Ex: Manutenção preventiva de servidor..."/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Datas e Registo">
                            <field name="request_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Descrição da Necessidade" name="description">
                            <field name="description" placeholder="Descreva os detalhes do problema ou pedido do cliente..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. List / Tree View -->
    <record id="view_sm_service_request_list" model="ir.ui.view">
        <field name="name">sm.service.request.list</field>
        <field name="model">sm.service.request</field>
        <field name="arch" type="xml">
            <list string="Solicitações de Serviço">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="request_date"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_analysis'"
                       decoration-success="state == 'quoted'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- 3. Search View -->
    <record id="view_sm_service_request_search" model="ir.ui.view">
        <field name="name">sm.service.request.search</field>
        <field name="model">sm.service.request</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Solicitações">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>

                <filter string="Rascunhos" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Em Análise" name="in_analysis" domain="[('state', '=', 'in_analysis')]"/>
                <filter string="Orçamentados" name="quoted" domain="[('state', '=', 'quoted')]"/>

                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Data da Solicitação" name="group_date" context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 4. Window Action -->
    <record id="action_sm_service_request" model="ir.actions.act_window">
        <field name="name">Solicitações de Serviço</field>
        <field name="res_model">sm.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sm_service_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma solicitação de serviço registada.
            </p>
            <p>
                Clique em "Novo" para registar o pedido inicial de um cliente.
            </p>
        </field>
    </record>

</odoo>