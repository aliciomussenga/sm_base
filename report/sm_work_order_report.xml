<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Declaração da Ação de Impressão (Aparece no botão 'Imprimir' da OS) -->
    <record id="action_report_sm_work_order" model="ir.actions.report">
        <field name="name">Ordem de Serviço (PDF)</field>
        <field name="model">sm.work.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sm_base.report_work_order_template</field>
        <field name="report_file">sm_base.report_work_order_template</field>
        <field name="binding_model_id" ref="model_sm_work_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. Template QWeb do Documento PDF -->
    <template id="report_work_order_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>
                                    <span>Ordem de Serviço: </span>
                                    <span t-field="doc.name"/>
                                </h2>
                            </div>
                            <div class="col-6 text-end">
                                <span class="badge bg-secondary fs-6" t-field="doc.state"/>
                            </div>
                        </div>

                        <!-- Dados do Cliente e Técnico -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Cliente:</strong>
                                <p t-field="doc.partner_id.name"/><br/>
                                <span t-field="doc.partner_id.street"/>
                            </div>
                            <div class="col-6">
                                <strong>Técnico Responsável:</strong>
                                <p t-field="doc.technician_id.name"/>
                                <strong>Data Limite:</strong>
                                <p t-field="doc.date_end"/>
                            </div>
                        </div>

                        <!-- Descrição do Serviço -->
                        <div class="card mb-4">
                            <div class="card-header fw-bold">Descrição dos Trabalhos</div>
                            <div class="card-body">
                                <p t-field="doc.description"/>
                            </div>
                        </div>

                        <!-- Assinaturas -->
                        <div class="row mt-5 pt-5">
                            <div class="col-6 text-center">
                                ____________________________________<br/>
                                <strong>Assinatura do Técnico</strong>
                            </div>
                            <div class="col-6 text-center">
                                ____________________________________<br/>
                                <strong>Assinatura do Cliente</strong>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>