<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template Principal do Relatório -->
    <template id="report_quotation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Orçamento N.º </span>
                            <span t-field="doc.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Cliente:</strong>
                                <!-- CORREÇÃO: Removido o </p> extra -->
                                <p t-field="doc.partner_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Data:</strong>
                                <!-- CORREÇÃO: Removido o </p> extra -->
                                <p t-field="doc.date_quotation"/>
                            </div>
                        </div>

                        <p>Documento de teste gerado com sucesso!</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>