<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Registo da Sequência para Orçamento -->
        <record id="seq_sm_quotatio" model="ir.sequence">
            <field name="name">Sequência de Orçamentos de Serviços</field>
            <field name="code">sm.quotation</field>
            <field name="prefix">ORC/%(year)s/</field>
