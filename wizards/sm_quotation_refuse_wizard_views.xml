<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_quotation_refuse_wizard_form" model="ir.ui.view">
        <field name="name">sm.quotation.refuse.wizard.form</field>
        <field name="model">sm.quotation.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Recusar Orçamento">
                <group>
                    <field name="quotation_id" invisible="1"/>
                    <field name="reason" placeholder="Descreva o motivo pelo qual a proposta foi recusada..."/>
                </group>
                <footer>
                    <button string="Confirmar Recusa" name="action_confirm_refuse" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>